# Works immediately without credentials. All provider calls run server-side.
AI_PROVIDER=mock
# Set AI_PROVIDER=openai and provide your own key to enable semantic review.
AI_API_KEY=
# OPENAI_API_KEY is also accepted. Never use NEXT_PUBLIC_ for secrets.
AI_MODEL=gpt-5.5
# Relative paths resolve from the repository; SQLite initializes automatically.
DATABASE_PATH=./data/decision-lab.sqlite
